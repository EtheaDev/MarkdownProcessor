        <DCCReference Include="MarkdownProcessor.Tests.Performance.pas"/>
        <DCCReference Include="MarkdownProcessor.Tests.Hooks.pas"/>
        <DCCReference Include="MarkdownProcessor.Tests.AST.pas"/>
        <DCCReference Include="..\source\MarkdownProcessorComponents.pas"/>
        <DCCReference Include="MarkdownProcessor.Tests.Component.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">MarkdownProcessor.Tests.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Android">False</Platform>
                <Platform value="Android64">False</Platform>
                <Platform value="iOSDevice64">False</Platform>
                <Platform value="iOSSimARM64">False</Platform>
                <Platform value="Linux64">False</Platform>
