        <DCCReference Include="..\source\MarkdownEntities.pas"/>
        <DCCReference Include="..\source\MarkdownLinkRefs.pas"/>
        <DCCReference Include="..\source\MarkdownBlockParser.pas"/>
        <DCCReference Include="..\source\MarkdownHtmlRenderer.pas"/>
        <DCCReference Include="..\source\MarkdownInlineParser.pas"/>
        <DCCReference Include="..\source\MarkdownGFM.pas"/>
        <DCCReference Include="..\source\MarkdownMath.pas"/>
        <DCCReference Include="..\source\MarkdownAlerts.pas"/>
        <DCCReference Include="MarkdownProcessor.Tests.Alerts.pas"/>
        <DCCReference Include="..\source\MarkdownLegacyExt.pas"/>
